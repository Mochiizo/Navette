{
  "name": "navette",
  "productName": "Navette",
  "version": "0.4.0",
  "description": "Transfert de fichiers en réseau local : PC ⇄ PC et PC ⇄ téléphone",
  "author": "Mochiizo",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n next,electron \"next dev -p 3123\" \"wait-on http://localhost:3123 && cross-env NAVETTE_DEV_URL=http://localhost:3123 electron .\"",
    "build:ui": "next build",
    "start": "next build && electron .",
    "test": "node --test test/*.test.js",
    "dist": "next build && electron-builder --win nsis --x64",
    "release": "next build && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9",
    "cross-env": "^10",
    "electron": "^45.3.4",
    "electron-builder": "^26.0.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5",
    "wait-on": "^8"
  },
  "build": {
    "appId": "app.navette.desktop",
    "productName": "Navette",
    "copyright": "© 2026 Mochiizo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Navette-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Navette",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mochiizo",
        "repo": "Navette",
        "releaseType": "release"
      }
    ]
  }
}
